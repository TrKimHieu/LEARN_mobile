# Copy thành apps/worker/.env (cùng thư mục này) — worker chạy với cwd = apps/worker nên chỉ đọc
# file đó, KHÔNG đọc .env ở gốc repo. Biến không đặt thì dùng mặc định trong src/environment.ts.

# mock = không gọi mạng, không cần key, bài học là nội dung mẫu (đủ để thử toàn bộ luồng).
# live = gọi mô hình thật, TÍNH TIỀN theo lượt vào key của bạn. Mỗi người dùng key của chính mình.
LLM_MODE=mock

# anthropic → Claude; google → Gemini (Google AI Studio); openai → GPT hoặc endpoint tương thích.
# Model phải cùng họ với provider:
#   anthropic: LLM_MODEL_GENERATION=claude-sonnet-5        LLM_MODEL_FAST=claude-haiku-4-5-20251001
#   google   : LLM_MODEL_GENERATION=gemini-3.1-flash-lite  LLM_MODEL_FAST=gemini-3.1-flash-lite
#   openai   : LLM_MODEL_GENERATION=gpt-6-luna  LLM_MODEL_FAST=gpt-6-luna
#              LLM_MODEL_FALLBACK=gpt-5-nano    LLM_REASONING_EFFORT=low
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL_GENERATION=gpt-6-luna
LLM_MODEL_FAST=gpt-6-luna
LLM_MODEL_FALLBACK=gpt-5-nano
LLM_REASONING_EFFORT=low
