# ─── LEARN production (một server) — chép thành .env.prod, KHÔNG commit .env.prod ───────────────
# Sinh secret: openssl rand -base64 48   (hoặc: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")

# Tên miền. Chưa có domain: dùng <IP-gạch-ngang>.sslip.io, vd IP 3.1.2.4 → 3-1-2-4.sslip.io
DOMAIN=3-1-2-4.sslip.io
APP_URL=https://3-1-2-4.sslip.io
# Presigned URL tải tài liệu ký bằng CHÍNH origin công khai (Caddy chuyển /learn-documents/* sang MinIO)
S3_PUBLIC_ENDPOINT=https://3-1-2-4.sslip.io

# ─── Cơ sở dữ liệu (container nội bộ, không mở cổng) ──────────────────────────────────────────
POSTGRES_USER=learn
POSTGRES_PASSWORD=change-me-long-secret
POSTGRES_DB=learn
DATABASE_URL=postgresql://learn:change-me-long-secret@postgres:5432/learn?schema=public
REDIS_URL=redis://redis:6379

# ─── Lưu trữ tài liệu (MinIO nội bộ) ─────────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=learn-documents
S3_ACCESS_KEY_ID=learn-minio
S3_SECRET_ACCESS_KEY=change-me-long-secret
S3_REGION=us-east-1

# ─── Xác thực ─────────────────────────────────────────────────────────────────────────────────
# API từ chối khởi động nếu còn giá trị dev (insecureProductionVars).
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-secret
# Tài khoản admin tạo khi seed lần đầu (ít nhất 12 ký tự). Seed production KHÔNG tạo tài khoản demo.
SEED_ADMIN_EMAIL=admin@learn.ai
SEED_ADMIN_PASSWORD=change-me-strong-admin-password

# ─── AI ───────────────────────────────────────────────────────────────────────────────────────
# live = gọi mô hình thật, TÍNH TIỀN theo lượt, ai đăng ký cũng bấm được → giữ trần chi phí thấp.
# mock = demo không tốn tiền (bài học là nội dung mẫu, mọi câu hỏi giống hệt nhau).
LLM_MODE=mock
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL_GENERATION=gpt-6-luna
LLM_MODEL_FAST=gpt-6-luna
# Model dự phòng khi model chính lỗi/quá tải; rỗng = không dự phòng.
LLM_MODEL_FALLBACK=gpt-5-nano
LLM_REASONING_EFFORT=low
# Đo ở dev với gpt-6-luna: một job 0,004–0,028 USD.
AI_JOB_MAX_COST_USD=0.05

# ─── Email (quên mật khẩu) ────────────────────────────────────────────────────────────────────
# log = không gửi thật (link chỉ nằm trong log server). smtp = gửi thật qua SMTP_URL.
MAIL_MODE=log
SMTP_URL=
MAIL_FROM=LEARN <no-reply@learn.local>

# ─── Khác ─────────────────────────────────────────────────────────────────────────────────────
BILLING_MODE=demo
APP_TIMEZONE=Asia/Ho_Chi_Minh
MIN_MOBILE_VERSION=1.0.0
