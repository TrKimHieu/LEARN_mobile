# ─── Học tập ────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
APP_URL=http://localhost:3000
# Múi giờ cắt "ngày" cho chuỗi học liên tiếp (tên IANA). Mặc định giờ Việt Nam.
APP_TIMEZONE=Asia/Ho_Chi_Minh
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://learn:learn@localhost:5432/learn?schema=public

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Object Storage (MinIO khi dev) ─────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=learn-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_PUT_URL_EXPIRES_SEC=900

# ─── LLM ───────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL_GENERATION=claude-sonnet-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODE=mock
# Tuỳ chọn — kịch bản sẵn cho MockLlmProvider (title/nội dung/bài tập chuẩn bị trước cho demo).
# Xem packages/ai/src/llm/fixtures.ts và apps/worker/fixtures/lessons.example.json.
MOCK_FIXTURES_PATH=
AI_JOB_MAX_COST_USD=0.50
AI_JOB_TIMEOUT_MS=900000
AI_MAX_CONCURRENT_CALLS=3

# ─── Upload limits ──────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=26214400
DOCUMENT_MAX_SIZE=26214400
UPLOAD_MAX_PAGES=300
OCR_MAX_PAGES=50

# ─── Billing ────────────────────────────────────────────────────────────
BILLING_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=